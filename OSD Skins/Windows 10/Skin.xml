<?xml version="1.0" encoding="utf-8"?>
<XMLskinSettings>
  <Info>
    <Author>Windows</Author>
    <WebSite>http://www.microsoft.com/</WebSite>
    <SkinVersion>3.0</SkinVersion>
  </Info>
  <OSD>
    <!--Orientation: BitMoveUp, BitMoveRight, BitStripBottom, BitStripRight, Horizontal, Vertical-->
    <!--LayerIndex: -1 - plNone, 0 - plAfterBack, 1 - plAfterAnimation, 2 - plAfterMeter, 3 - plAfterText, 4 - plAfterDigits, 5 - plAfterGlass-->
    <!--Color: #AARRGGBB-->
    <!--Alignment: 0 - taLeft, 1 - taCenter, 2 - taRight-->
    <FadeSteps>28</FadeSteps>
    <ShowSteps>40</ShowSteps>
    <MotionSteps>-1</MotionSteps>
    <!--MotionDirection: Auto (nearest screen edge), Bottom, Top, Left, Right-->
    <MotionDirection>Auto</MotionDirection>
    <Colorization>false</Colorization>
    <!--Value format: #AARRGGBB. -1 - Use system color-->
    <ColorizationColor>-1</ColorizationColor>
    <Background Colorize="true"/>
    <Meter X="63" Y="43" Orientation="BITMOVERIGHT" Min="0" Max="225" HideOnMute="false" Colorize="true">
      <Click Grow="2"/>
    </Meter>
    <MeterMute X="63" Y="43" Orientation="BITMOVERIGHT" Min="0" Max="225" Colorize="true"/>
    <MeterEffect Enable="true" Orientation="BITSTRIPBOTTOM" Min="0" Max="3" LayerIndex="0" HideOnMute="true" X="16" Y="39" Colorize="false" FileName="" AppIcon="false">
      <Click Action="Mute" Grow="3" HoverColor="#FFCFE8FF" PressedColor="#FF8FC4F5"/>
    </MeterEffect>
    <MeterMuteEffect Enable="true" LayerIndex="0" X="16" Y="39" Colorize="false">
      <Click Action="Mute" Grow="3" HoverColor="#FFCFE8FF" PressedColor="#FF8FC4F5"/>
    </MeterMuteEffect>
    <AppIcon Enable="false" LayerIndex="0" X="0" Y="0" Size="0" HideOnMute="false"/>
    <DigitalMeter Orientation="BITSTRIPBOTTOM">
      <Hundreds X="304" Y="46" HideZero="true"/>
      <Tens X="316" Y="46" HideZero="true"/>
      <Tens1 X="-1" Y="-1"/>
      <Units X="330" Y="46" HideZero="false"/>
      <Units1 X="-1" Y="-1"/>
      <Units2 X="-1" Y="-1"/>
    </DigitalMeter>
    <PeakMeter Enable="true" LayerIndex="0" Colorize="false" Style="MONO" Orientation="HORIZONTAL" Max="100">
      <LeftChannel X="64" Y="53" Inverse="false"/>
      <RightChannel X="0" Y="0" Inverse="false"/>
    </PeakMeter>
    <Text Enable="true" X="10" Y="23" Format="%DF" FormatMute="%DF" Alignment="0" HideOnMute="false" LayerIndex="-1">
      <Font Size="16" Color="#FFFFFFFF" ColorMute="#FFFFFFFF" Name="Segoe UI" Bold="false" Italic="false"/>
    </Text>
    <NotificationText Enable="false" X="0" Y="0" Width="0" Height="0" Alignment="0" LayerIndex="-1">
      <Font Size="16" Color="#FF000000" Name="" Bold="false" Italic="false"/>
    </NotificationText>
    <CDDriveLetter Enable="false" X="0" Y="0" Alignment="0" LayerIndex="-1">
      <Font Size="16" Color="#FF000000" Name="" Bold="false" Italic="false"/>
    </CDDriveLetter>
    <USBDriveLetter Enable="false" X="0" Y="0" Alignment="0" LayerIndex="-1">
      <Font Size="16" Color="#FF000000" Name="" Bold="false" Italic="false"/>
    </USBDriveLetter>
    <USBFriendlyName Enable="false" X="0" Y="0" Alignment="0" LayerIndex="-1">
      <Font Size="16" Color="#FF000000" Name="" Bold="false" Italic="false"/>
    </USBFriendlyName>
  </OSD>
  <Layers>
    <Layer Enable="true" Image="Meter_Track.svg" X="64" Y="54" LayerIndex="0" Colorize="true" HideOnMute="true"/>
  </Layers>
  <Media Enable="true" Keys="true">
    <Cover Enable="true" X="290" Y="10" Size="60" Radius="2"/>
    <Text Enable="true" X="10" Y="20" Alignment="0" MaxWidth="280" Format="%t">
      <Font Size="14" Color="#FFFFFFFF" Name="Segoe UI" Bold="false" Italic="false"/>
    </Text>
    <Text Enable="true" X="64" Y="48" Alignment="0" MaxWidth="280" Format="%a">
      <Font Size="13" Color="#FFFFFFFF" Name="Segoe UI" Bold="false" Italic="false"/>
    </Text>
    <Text Enable="false" X="350" Y="83" Alignment="2" MaxWidth="0" Format="%e/%d">
      <Font Size="12" Color="#CCFFFFFF" Name="Segoe UI" Bold="false" Italic="false"/>
    </Text>
    <Progress Enable="true" X="10" Y="72" Width="270" Height="3" TrackColor="#4CFFFFFF" FillColor="#FFFEFEFE">
      <Click Grow="6"/>
    </Progress>
    <PlayPause Enable="true" X="23" Y="35" Image="Media_PlayPause.svg">
      <Click Grow="5"/>
    </PlayPause>
    <Previous Enable="false" X="0" Y="0" Image=""/>
    <Next Enable="false" X="0" Y="0" Image=""/>
  </Media>
</XMLskinSettings>
