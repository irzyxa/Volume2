    <!--Alignment: 0 - taLeft, 1 - taCenter, 2 - taRight-->
    <FadeSteps>52</FadeSteps>
    <ShowSteps>0</ShowSteps>
    <MotionSteps>-1</MotionSteps>
    <!--MotionDirection: Auto (nearest screen edge), Bottom, Top, Left, Right-->
    <MotionDirection>Auto</MotionDirection>
    <Colorization>false</Colorization>
    <!--Value format: #AARRGGBB. -1 - Use system color-->
    <ColorizationColor>-1</ColorizationColor>
