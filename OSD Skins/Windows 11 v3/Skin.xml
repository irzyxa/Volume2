<?xml version="1.0" encoding="utf-8"?>
<XMLskinSettings>
  <Info>
    <Author>Microsoft</Author>
    <WebSite>http://microsoft.com</WebSite>
    <SkinVersion>3.0</SkinVersion>
  </Info>
  <OSD>
    <!--Orientation: BitMoveUp, BitMoveRight, BitStripBottom, BitStripRight, Horizontal, Vertical-->
    <!--LayerIndex: -1 - plNone, 0 - plAfterBack, 1 - plAfterAnimation, 2 - plAfterMeter, 3 - plAfterText, 4 - plAfterDigits, 5 - plAfterGlass-->
    <!--Color: #AARRGGBB-->
    <!--Alignment: 0 - taLeft, 1 - taCenter, 2 - taRight-->
    <FadeSteps>18</FadeSteps>
    <ShowSteps>36</ShowSteps>
    <MotionSteps>26</MotionSteps>
    <Colorization>true</Colorization>
    <!--Value format: #AARRGGBB. -1 - Use system color. System - accent shade of the Windows 11 flyout (AccentDark1, AccentLight2 in a dark color scheme). AccentLight3..AccentLight1, Accent, AccentDark1..AccentDark3 - Windows accent palette shade-->
    <ColorizationColor>System</ColorizationColor>
    <Background Colorize="false"/>
    <Meter X="60" Y="34" Orientation="HORIZONTAL" Min="0" Max="110" HideOnMute="false" Colorize="true">
      <Click Grow="6"/>
    </Meter>
    <MeterMute X="0" Y="0" Orientation="HORIZONTAL" Min="0" Max="0" Colorize="true"/>
    <!--101 frames: the frame is the volume percent, with the Windows 11 icon thresholds-->
    <MeterEffect Enable="true" Orientation="BitStripBottom" Min="0" Max="100" LayerIndex="0" HideOnMute="true" X="31" Y="28" Colorize="false" FileName="" AppIcon="true">
      <Click Action="Mute" Grow="3" HoverColor="System" PressedColor="AccentDark2" HoverColorDark="System" PressedColorDark="AccentLight1"/>
    </MeterEffect>
    <MeterMuteEffect Enable="true" LayerIndex="0" X="31" Y="28" Colorize="false">
      <Click Action="Mute" Grow="3" HoverColor="System" PressedColor="AccentDark2" HoverColorDark="System" PressedColorDark="AccentLight1"/>
    </MeterMuteEffect>
    <PeakMeter Enable="false" LayerIndex="0" Colorize="false" Style="MONO" Orientation="HORIZONTAL" Max="100">
      <LeftChannel X="0" Y="0" Inverse="false"/>
      <RightChannel X="0" Y="0" Inverse="false"/>
    </PeakMeter>
    <Text Enable="true" X="191" Y="36" Format="%V" FormatMute="%V" Alignment="1" HideOnMute="false" LayerIndex="-1">
      <Font Size="14" Color="#E4000000" ColorDark="#FFFFFFFF" ColorMute="#E4000000" ColorMuteDark="#FFFFFFFF" Name="Segoe UI" Bold="false" Italic="false"/>
    </Text>
    <NotificationText Enable="false" X="0" Y="0" Width="0" Height="0" Alignment="0" LayerIndex="-1">
      <Font Size="16" Color="#FF000000" Name="Tahoma" Bold="false" Italic="false"/>
    </NotificationText>
    <CDDriveLetter Enable="true" X="60" Y="36" Alignment="0" LayerIndex="-1">
      <Font Size="14" Color="#E4000000" ColorDark="#FFFFFFFF" Name="Segoe UI" Bold="false" Italic="false"/>
    </CDDriveLetter>
    <USBDriveLetter Enable="true" X="60" Y="36" Alignment="0" LayerIndex="-1">
      <Font Size="14" Color="#E4000000" ColorDark="#FFFFFFFF" Name="Segoe UI" Bold="false" Italic="false"/>
    </USBDriveLetter>
    <USBFriendlyName Enable="true" X="84" Y="36" Alignment="0" LayerIndex="-1">
      <Font Size="12" Color="#9B000000" ColorDark="#C5FFFFFF" Name="Segoe UI" Bold="false" Italic="false"/>
    </USBFriendlyName>
  </OSD>
  <Media Enable="true" Image="Media.svg">
    <!--The layout of the Windows 11 media flyout: the player on top, the cover on the right, the times under the progress bar, the buttons centered at the bottom-->
    <AppIcon Enable="true" X="42" Y="29" Size="16"/>
    <Text Enable="true" X="64" Y="36" Alignment="0" MaxWidth="352" Format="%n">
      <Font Size="12" Color="#E4000000" ColorDark="#FFFFFFFF" Name="Segoe UI" Bold="false" Italic="false"/>
    </Text>
    <Cover Enable="true" X="294" Y="57" Size="58" Radius="4"/>
    <Levels Enable="true" X="288" Y="57" Width="6" Height="58" BarWidth="2" Orientation="Vertical" Color="Colorization" ColorPaused="#9B000000" ColorPausedDark="#C5FFFFFF"/>
    <Text Enable="true" X="39" Y="79" Alignment="0" MaxWidth="276" Format="%t">
      <Font Size="14" Color="#E4000000" ColorDark="#FFFFFFFF" Name="Segoe UI Semibold" Bold="false" Italic="false"/>
    </Text>
    <Text Enable="true" X="40" Y="96" Alignment="0" MaxWidth="276" Format="%a">
      <Font Size="12" Color="#E4000000" ColorDark="#FFFFFFFF" Name="Segoe UI" Bold="false" Italic="false"/>
    </Text>
    <Progress Enable="true" X="42" Y="125" Width="310" Height="3" TrackColor="#1F000000" FillColor="Colorization" TrackColorDark="#33FFFFFF">
      <Click Grow="6"/>
    </Progress>
    <Text Enable="true" X="40" Y="140" Alignment="0" MaxWidth="0" Format="%e">
      <Font Size="12" Color="#9B000000" ColorDark="#C5FFFFFF" Name="Segoe UI" Bold="false" Italic="false"/>
    </Text>
    <Text Enable="true" X="352" Y="140" Alignment="2" MaxWidth="0" Format="%d">
      <Font Size="12" Color="#9B000000" ColorDark="#C5FFFFFF" Name="Segoe UI" Bold="false" Italic="false"/>
    </Text>
    <Previous Enable="true" X="123" Y="158" Image="Media_Previous.svg">
      <Click Grow="10" HoverColor="System" PressedColor="AccentDark2" HoverColorDark="System" PressedColorDark="AccentLight1"/>
    </Previous>
    <PlayPause Enable="true" X="189" Y="158" Image="Media_PlayPause.svg">
      <Click Grow="10" HoverColor="System" PressedColor="AccentDark2" HoverColorDark="System" PressedColorDark="AccentLight1"/>
    </PlayPause>
    <Next Enable="true" X="255" Y="158" Image="Media_Next.svg">
      <Click Grow="10" HoverColor="System" PressedColor="AccentDark2" HoverColorDark="System" PressedColorDark="AccentLight1"/>
    </Next>
  </Media>
  <Layers>
    <Layer Enable="true" Image="Meter_Track.svg" X="60" Y="34" LayerIndex="0" Colorize="false"/>
  </Layers>
</XMLskinSettings>
